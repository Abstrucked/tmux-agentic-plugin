#!/usr/bin/env bash
# tmux-agent -- agent awareness for tmux. Detects coding agents running in
# panes (opencode, claude, codex, ...) and tracks their state:
#   blocked (red)    -- needs input or approval
#   working (yellow) -- actively running
#   ready (blue)     -- finished, the pane has not been looked at since
#   idle (green)     -- finished and seen
#
# Subcommands:
#   strip [--max N]      state mark + agent name for the status bar
#   window-dot <win_id>  rollup state dot for a window status entry
#   pane-label <pane_id> agent + state label for pane-border-format
#   seen <pane_id>       mark the pane's state as seen (pane-focus-in hook)
#   status [--json] [--remote]   list agent panes and states; --remote
#                        adds agents on other hosts
#   status --porcelain   this host's agents as state|agent|pane|target|
#                        window|age|path (what other hosts fetch)
#   pick                 fuzzy finder over agent panes (prefix + a)
#   read --pane <id> [--lines N] [--ansi]   pane snapshot for fzf previews
#   wait --pane <id> --state <state> [--timeout SEC]
#   report --pane <id> --state <state>      hook-reported state override
#   hook <agent> <event> agent lifecycle hook (Claude Code, Codex, OpenCode)
#   install-hooks [--remove] [claude|codex|opencode ...]
#                        wire the agents' hooks up (or remove them)
#   place-strip [--max N]  centre the strip in the status bar
#   attach [--next|--urgent] [--from <pane>]
#                        jump to the most urgent agent pane; --urgent only
#                        to blocked, error, then ready ones (prefix + A), cycling
#                        past --from
#   focus --pane <id>    switch a client to the pane and raise its terminal
#                        window (what clicking a notification does)
#   refresh              update cached state now
#   send --pane <id> [--expect-state S] [--expect-epoch E] (--key K | --text T)...
#                        type into an agent pane, in order: --key takes
#                        Enter Escape Tab Space BSpace Up Down Left Right
#                        C-c or one of y n Y N 0-9; --text is literal.
#                        With --expect-state, exit 3 without typing unless
#                        the pane is in that state; with --expect-epoch, or
#                        unless its detail line (a prompt) is still E's
#   detail --pane <id>   the one-line context a hook reported (what is
#                        being asked, what the agent said, the error)
#   diff --pane <id>     git diff of the pane's directory (stat, diff and
#                        untracked files)
#   mobile               tap-friendly agent list and action menu for a
#                        phone terminal (Termius over ssh)
#   doctor               check the install, hooks, cache, remotes and
#                        notifications
#   explain --pane <id>  why a pane shows the state it does
#   remotes              list remote hosts and how their last fetch went
#   remote-refresh       fetch every remote host's agents now
#   watch                stream this host's agents to other hosts: lines
#                        then "--" on every change, and every 5s (they
#                        keep one running over ssh)
#
# Remote agents: hosts in @tmux-agent-remotes, plus live ssh ControlMaster
# connections, are asked over ssh for their agents (lib/remote.sh). They
# show up everywhere local ones do, as agent@host, and jumping to one opens
# a window with a nested tmux client on that host. Pane arguments take
# "<key>/<pane>" ids for them.
#
# State is cached in $TMUX_AGENT_STATE_DIR (default
# $XDG_RUNTIME_DIR or /tmp, then tmux-agent-$UID/<tmux server>, mode 0700).
# tmux's status interval drives refreshes. Desktop notifications are off
# with the tmux option @tmux-agent-notify off (or TMUX_AGENT_QUIET=1).
# Clicking one runs focus; lib/raise finds the window (see
# @tmux-agent-raise-command there). The
# strip names agents up to --max (default $TMUX_AGENT_STRIP_MAX, else 4),
# then counts them per state.
set -euo pipefail

SELF="$(readlink -f "$0")"
# shellcheck source=../lib/engine.sh
. "$(dirname "$SELF")/../lib/engine.sh"
# shellcheck source=../lib/remote.sh
. "$(dirname "$SELF")/../lib/remote.sh"
# shellcheck source=../lib/notify.sh
. "$(dirname "$SELF")/../lib/notify.sh"
# shellcheck source=../lib/pick.sh
. "$(dirname "$SELF")/../lib/pick.sh"
# shellcheck source=../lib/doctor.sh
. "$(dirname "$SELF")/../lib/doctor.sh"

private_dir() {
    # $1 path. Create it 0700 if missing; true only for a real directory
    # (not a symlink) that is ours.
    [[ -L $1 ]] && return 1
    [[ -d $1 ]] || (umask 077 && mkdir "$1" 2>/dev/null) || [[ -d $1 ]] || return 1
    [[ ! -L $1 && -d $1 && -O $1 ]] || return 1
    chmod 700 "$1" 2>/dev/null || true
}

default_state_dir() {
    # The state holds prompt lines and permission commands, so it must not
    # be readable by other users, nor planted by one: the per-user parent
    # and the per-server dir are made 0700 and must be ours and not
    # symlinks. Otherwise this run gets a private temp dir instead.
    local base=${TMPDIR:-/tmp} parent dir
    [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]] && base=$XDG_RUNTIME_DIR
    parent="$base/tmux-agent-$UID"
    dir="$parent/$(ta_server_key)"
    if private_dir "$parent" && private_dir "$dir"; then
        printf '%s' "$dir"
        return 0
    fi
    # The fallback must be the same dir on every run (the status bar runs
    # us every few seconds, and seen marks and reports live there).
    echo "tmux-agent: $parent is not a private directory of yours; using a cache dir instead" >&2
    base=${XDG_CACHE_HOME:-${HOME:-}/.cache}
    if [[ -n ${HOME:-}${XDG_CACHE_HOME:-} ]]; then
        [[ -d $base ]] || (umask 077 && mkdir -p "$base" 2>/dev/null) || true
        parent="$base/tmux-agent"
        dir="$parent/$(ta_server_key)"
        if [[ -d $base ]] && private_dir "$parent" && private_dir "$dir"; then
            printf '%s' "$dir"
            return 0
        fi
    fi
    mktemp -d "${TMPDIR:-/tmp}/tmux-agent-XXXXXX"
}

TA_STATE_DIR=${TMUX_AGENT_STATE_DIR:-}
[[ -n $TA_STATE_DIR ]] || TA_STATE_DIR=$(default_state_dir)
declare -r TA_STATE_DIR
declare -r TA_PANE_FMT='#{pane_id}|#{pane_pid}|#{window_id}|#{session_name}:#{window_index}.#{pane_index}|#{pane_current_path}'
declare -r TA_REPORT_TTL=300

now() { date +%s; }

age_str() {
    local s=$1
    if ((s < 3600)); then
        echo "$((s / 60))m"
    elif ((s < 86400)); then
        echo "$((s / 3600))h"
    else
        echo "$((s / 86400))d"
    fi
}

tail_lines() {
    # Last $1 non-empty lines of stdin.
    grep -v '^[[:space:]]*$' | tail -n "${1:-12}" || true
}

pane_in_view() {
    # True when a focused client shows $1: its window is the session's
    # current one and it is that window's active pane.
    local name
    while read -r name; do
        [[ -n $name ]] || continue
        [[ $(tmux display-message -p -c "$name" '#{pane_id}' 2>/dev/null) == "$1" ]] && return 0
    done < <(tmux list-clients -F '#{?#{m:*focused*,#{client_flags}},#{client_name},}' 2>/dev/null)
    return 1
}

mark_seen() {
    mkdir -p "$TA_STATE_DIR"
    now >"$TA_STATE_DIR/seen-$1"
}

cmd_seen() {
    # $1 pane id, or "<key>/<pane>" for a remote agent.
    if [[ $1 == */* ]]; then
        ta_remote_ssh "${1%%/*}" seen "${1#*/}" >/dev/null 2>&1 || true
        return 0
    fi
    mark_seen "$1"
}

refresh() {
    # Hooks refresh in the background while the status bar polls. Serialize
    # scans so a transition is seen, and notified, exactly once.
    # The lock fd is global so notify() can close it in its background job.
    local rc=0
    mkdir -p "$TA_STATE_DIR"
    if command -v flock >/dev/null 2>&1; then
        exec {TA_LOCK_FD}>"$TA_STATE_DIR/lock"
        flock "$TA_LOCK_FD"
        scan "$@" || rc=$?
        exec {TA_LOCK_FD}>&-
        TA_LOCK_FD=''
        return "$rc"
    fi
    # No flock (macOS): mkdir is atomic. A lock held past 10s was left by
    # a killed scan, so take it over.
    local lock="$TA_STATE_DIR/lock.d" tries=0
    until mkdir "$lock" 2>/dev/null; do
        if ((++tries > 100)); then
            rmdir "$lock" 2>/dev/null || true
            tries=0
        fi
        sleep 0.1
    done
    scan "$@" || rc=$?
    rmdir "$lock" 2>/dev/null || true
    return "$rc"
}

report_authoritative() {
    # $1 reported state, $2 its epoch, $3 now, $4 1 when an agent process is
    # detected. A hook-reported state wins over the heuristics. Agent hooks
    # report every transition, so their settled states hold while the agent
    # lives. "working" and reports without a detected agent expire: an
    # interrupted turn fires no Stop hook.
    [[ -n $1 ]] || return 1
    (($3 - $2 < TA_REPORT_TTL)) && return 0
    [[ $4 == 1 && $1 != working ]]
}

scan() {
    # Scan every pane once per TA_STATE_DIR/stamp interval (3s) unless forced.
    local force=${1:-0} now_s stamp
    now_s=$(now)
    stamp="$TA_STATE_DIR/stamp"
    if [[ $force != 1 && -f $stamp ]]; then
        ((now_s - $(cat "$stamp") >= 3)) || return 0
    fi
    printf '%s\n' "$now_s" >"$stamp"

    local pane pid wid target path detect agent apid cpu tail tail_hash
    local state prev prev_cpu prev_tail_hash changed seen output_changed rstate repoch f base authoritative
    local -A live=()
    # One ps per scan: detection of every pane reads the same snapshot.
    ta_ps_snapshot
    while IFS='|' read -r pane pid wid target path; do
        [[ -n $pane ]] || continue
        live[$pane]=1
        detect=$(ta_detect_agent "$pid" || true)
        if [[ -z $detect && ! -f $TA_STATE_DIR/report-$pane ]]; then
            rm -f "$TA_STATE_DIR/state-$pane" "$TA_STATE_DIR/seen-$pane"
            continue
        fi
        agent=custom apid='' cpu=0
        if [[ -n $detect ]]; then
            read -r agent apid <<<"$detect"
            cpu=$(ta_proc_cpu "$apid" || echo 0)
        fi
        prev='' prev_cpu=0 prev_tail_hash='' changed=$now_s
        if [[ -f $TA_STATE_DIR/state-$pane ]]; then
            IFS='|' read -r prev _ag prev_cpu changed _up _tgt _wid _path prev_tail_hash \
                <"$TA_STATE_DIR/state-$pane" || true
            [[ $prev_cpu =~ ^[0-9]+$ ]] || prev_cpu=0
            [[ $changed =~ ^[0-9]+$ ]] || changed=$now_s
        fi
        # A hook-reported state wins over the heuristics (report_authoritative).
        rstate='' repoch=0 authoritative=0
        if [[ -f $TA_STATE_DIR/report-$pane ]]; then
            IFS='|' read -r rstate repoch <"$TA_STATE_DIR/report-$pane" || true
            [[ $repoch =~ ^[0-9]+$ ]] || repoch=0
            if report_authoritative "$rstate" "$repoch" "$now_s" "$([[ -n $detect ]] && echo 1 || echo 0)"; then
                authoritative=1
            fi
        fi
        # A settled report decides the state alone: skip the capture and
        # keep the last tail hash. "working" still reads the screen, for
        # the interrupted check.
        if ((authoritative)) && [[ $rstate != working && -n $prev_tail_hash ]]; then
            tail='' tail_hash=$prev_tail_hash
        else
            tail=$(tmux capture-pane -p -J -S -30 -t "$pane" 2>/dev/null | tail_lines 12 || true)
            read -r tail_hash _ <<<"$(cksum <<<"$tail")"
        fi
        # An interrupted turn fires no Stop hook: let the heuristics decide.
        if ((authoritative)) && [[ $rstate == working ]] && ta_match_interrupted "$tail"; then
            rm -f "$TA_STATE_DIR/report-$pane"
            authoritative=0
        fi
        output_changed=0
        if [[ -n $prev_tail_hash && $tail_hash != "$prev_tail_hash" ]]; then
            output_changed=1
        fi
        seen=0
        if [[ -f $TA_STATE_DIR/seen-$pane ]]; then
            (($(cat "$TA_STATE_DIR/seen-$pane") >= changed)) && seen=1
        fi

        state=$(ta_classify "$tail" "$((cpu - prev_cpu))" "$prev" "$seen" "$output_changed")
        if ((authoritative)); then
            state=$rstate
            # Seen after the agent reported it finished: acknowledged.
            if [[ $state == ready || $state == error ]] && [[ -f $TA_STATE_DIR/seen-$pane ]] &&
                (($(cat "$TA_STATE_DIR/seen-$pane") >= repoch)); then
                state=idle
            fi
        elif [[ -f $TA_STATE_DIR/report-$pane ]]; then
            rm -f "$TA_STATE_DIR/report-$pane"
        fi

        [[ $state == "$prev" ]] || changed=$now_s
        printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
            "$state" "$agent" "$cpu" "$changed" "$now_s" "$target" "$wid" "$path" "$tail_hash" \
            >"$TA_STATE_DIR/state-$pane"

        # Notify on real transitions of panes nobody is looking at.
        if [[ -z ${TMUX_AGENT_QUIET:-} && -n $prev && $state != "$prev" ]] &&
            { [[ $state == blocked || $state == ready || $state == error ]]; } &&
            ! pane_in_view "$pane"; then
            notify "$agent" "$state" "$target" "$path" "$pane"
        fi
    done < <(tmux list-panes -a -F "$TA_PANE_FMT" 2>/dev/null || true)

    for f in "$TA_STATE_DIR"/state-* "$TA_STATE_DIR"/seen-* "$TA_STATE_DIR"/report-* "$TA_STATE_DIR"/detail-*; do
        [[ -e $f ]] || continue
        base=${f##*-}
        [[ -n ${live[$base]:-} ]] || rm -f "$f"
    done
}

each_agent() {
    # Every agent, most urgent first and local before remote within a
    # state: "state|agent|host|target|age|id|path". Local agents have no
    # host and a pane id; remote ones have the host's name and a
    # "<key>/<pane>" id (see lib/remote.sh). --local leaves remote ones out.
    local local_only=0 now_s s f st ag ch tgt path remote=''
    [[ ${1:-} == --local ]] && local_only=1
    now_s=$(now)
    ((local_only)) || remote=$(ta_remote_agents)
    for s in $TA_STATES; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            IFS='|' read -r st ag _ ch _ tgt _ path _ <"$f" || continue
            [[ $st == "$s" ]] || continue
            [[ $ch =~ ^[0-9]+$ ]] || ch=$now_s
            printf '%s|%s||%s|%s|%s|%s\n' "$st" "$ag" "$tgt" "$((now_s - ch))" "${f##*-}" "$path"
        done
        [[ -z $remote ]] || grep "^$s|" <<<"$remote" || true
    done
}

strip_item() {
    # $1 state, $2 agent name or count. Coloured state mark, then the label:
    # white, or gray once idle so settled agents step back. Names and counts
    # both get a space after the mark.
    local label=white
    [[ $1 == idle ]] && label=gray
    printf '#[fg=%s]%s #[fg=%s]%s#[default]' \
        "$(ta_state_color "$1")" "$(ta_state_char "$1")" "$label" "$2"
}

strip_max() {
    # Name limit for the strip: "--max N" in $@, else TMUX_AGENT_STRIP_MAX,
    # else 4. Non-numbers fall back to 4: the value ends up in arithmetic.
    local max=${TMUX_AGENT_STRIP_MAX:-4}
    while (($#)); do
        case $1 in
        --max)
            max=${2:-}
            shift $(($# > 1 ? 2 : 1))
            ;;
        *) shift ;;
        esac
    done
    [[ $max =~ ^[0-9]+$ ]] || max=4
    echo "$max"
}

strip() {
    # One "mark name" per agent, most urgent first. Past the limit (see
    # strip_max), keep the bar short: one "mark count" per state, naming
    # only blocked agents while there are at most two of them.
    local max
    max=$(strip_max "$@")
    refresh
    ta_remote_tick
    local st ag host s i out=''
    local -a sts=() ags=()
    local -A n=()
    while IFS='|' read -r st ag host _; do
        sts+=("$st") ags+=("$ag${host:+@$host}")
        n[$st]=$((${n[$st]:-0} + 1))
    done < <(each_agent)
    if ((${#sts[@]} <= max)); then
        for i in "${!sts[@]}"; do
            out="$out${out:+  }$(strip_item "${sts[i]}" "${ags[i]}")"
        done
    else
        for s in $TA_STATES; do
            ((${n[$s]:-0})) || continue
            if [[ $s == blocked ]] && ((n[$s] <= 2)); then
                for i in "${!sts[@]}"; do
                    [[ ${sts[i]} == blocked ]] || continue
                    out="$out${out:+  }$(strip_item blocked "${ags[i]}")"
                done
            else
                out="$out${out:+  }$(strip_item "$s" "${n[$s]}")"
            fi
        done
    fi
    printf '%s' "$out"
}

window_dot() {
    local wid=$1 f st w worst=''
    refresh
    for f in "$TA_STATE_DIR"/state-*; do
        [[ -e $f ]] || continue
        IFS='|' read -r st _ag _cpu _ch _up _tgt w _path <"$f" || continue
        [[ $w == "$wid" ]] || continue
        worst=$(ta_rollup "$worst" "$st")
    done
    if [[ -n $worst ]]; then
        printf '#[fg=%s]●' "$(ta_state_color "$worst")"
    fi
}

pane_label() {
    local pane=$1 f st ag
    refresh
    f="$TA_STATE_DIR/state-$pane"
    if [[ ! -f $f ]]; then
        tmux display-message -p -t "$pane" '#{pane_index} #{pane_title}' 2>/dev/null || printf 'shell'
        return 0
    fi
    IFS='|' read -r st ag _rest <"$f"
    printf ' #[fg=%s]%s %s · %s ' "$(ta_state_color "$st")" "$(ta_agent_glyph "$ag")" "$ag" "$st"
}

porcelain() {
    # This host's agents, one per line: state|agent|pane|target|window|age|
    # path. What other hosts fetch over ssh, so no jq or colour, and never
    # remote agents (two hosts listing each other must not loop).
    local f st ag ch up tgt wid path s
    for s in $TA_STATES; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            IFS='|' read -r st ag _ ch up tgt wid path _ <"$f" || continue
            [[ $st == "$s" ]] || continue
            [[ $ch =~ ^[0-9]+$ && $up =~ ^[0-9]+$ ]] || ch=0 up=0
            printf '%s|%s|%s|%s|%s|%s|%s\n' "$st" "$ag" "${f##*-}" "$tgt" "$wid" "$((up - ch))" "$path"
        done
    done
}

cmd_status() {
    local json=0 scope=--local
    while (($#)); do
        case $1 in
        --json) json=1 ;;
        --remote) scope='' ;;
        --porcelain)
            refresh
            porcelain
            return 0
            ;;
        esac
        shift
    done
    refresh
    local st ag host tgt age id path detail
    while IFS='|' read -r st ag host tgt age id path; do
        if ((json)); then
            detail=''
            [[ -n $host ]] || detail=$(ta_detail_read "$TA_STATE_DIR" "$id" || true)
            jq -cn --arg pane "$id" --arg state "$st" --arg agent "$ag" \
                --arg target "$tgt" --arg path "$path" --arg host "$host" --arg detail "$detail" \
                --argjson age "$age" \
                '{pane:$pane,state:$state,agent:$agent,target:$target,path:$path,age:$age,detail:$detail}
                 + if $host == "" then {} else {host:$host} end'
        else
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$(ta_state_mark "$st")" \
                "$ag${host:+@$host}" "${path##*/}" "$tgt" "$(age_str "$age")" "$id"
        fi
    done < <(each_agent $scope)
}

cmd_read() {
    local pane='' lines=20 ansi=0
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --lines)
            lines=$2
            shift 2
            ;;
        --ansi)
            ansi=1
            shift
            ;;
        *) shift ;;
        esac
    done
    if [[ $pane == */* ]]; then
        local -a args=(read --pane "${pane#*/}" --lines "$lines")
        ((ansi)) && args+=(--ansi)
        ta_remote_ssh "${pane%%/*}" "${args[@]}" 2>/dev/null || true
        return 0
    fi
    local -a opts=(-p -J -S "-$((lines * 2))" -t "$pane")
    ((ansi)) && opts+=(-e)
    tmux capture-pane "${opts[@]}" 2>/dev/null | tail_lines "$lines" || true
}

pane_arg() {
    # The value of --pane in $@.
    while (($#)); do
        if [[ $1 == --pane ]]; then
            printf '%s' "${2:-}"
            return 0
        fi
        shift
    done
}

cmd_detail() {
    local pane
    pane=$(pane_arg "$@")
    [[ -n $pane ]] || return 0
    if [[ $pane == */* ]]; then
        ta_remote_ssh "${pane%%/*}" detail --pane "${pane#*/}" 2>/dev/null || true
        return 0
    fi
    ta_detail_read "$TA_STATE_DIR" "$pane" || true
}

cmd_diff() {
    local pane path='' f
    pane=$(pane_arg "$@")
    [[ -n $pane ]] || return 1
    if [[ $pane == */* ]]; then
        ta_remote_ssh "${pane%%/*}" diff --pane "${pane#*/}" 2>/dev/null || true
        return 0
    fi
    f="$TA_STATE_DIR/state-$pane"
    [[ -f $f ]] && IFS='|' read -r _ _ _ _ _ _ _ path _ <"$f"
    # The repo is the agent's working directory, so its .git/config and
    # .gitattributes are not trusted: no fsmonitor hook, external diff or
    # textconv driver may run.
    local -a git=(git --no-pager -c core.fsmonitor=false -c diff.external= -C "$path")
    if [[ -z $path ]] || ! "${git[@]}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "not a git repository: $path"
        return 0
    fi
    "${git[@]}" diff --no-ext-diff --no-textconv --stat || true
    "${git[@]}" diff --no-ext-diff --no-textconv --color=always || true
    "${git[@]}" status --short | grep '^??' || true
}

cmd_wait() {
    local pane='' want='' timeout=0 waited=0 st
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        --timeout)
            timeout=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    if [[ $pane == */* ]]; then
        ta_remote_ssh_stream "${pane%%/*}" wait --pane "${pane#*/}" --state "$want" \
            ${timeout:+--timeout "$timeout"}
        return
    fi
    while :; do
        refresh
        st=''
        if [[ -f $TA_STATE_DIR/state-$pane ]]; then
            IFS='|' read -r st _rest <"$TA_STATE_DIR/state-$pane" || true
        fi
        [[ $st == "$want" ]] && return 0
        if ((timeout > 0 && waited >= timeout)); then
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

cmd_report() {
    local pane='' want=''
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    [[ -n $pane && -n $want ]] || return 1
    mkdir -p "$TA_STATE_DIR"
    printf '%s|%s\n' "$want" "$(now)" >"$TA_STATE_DIR/report-$pane"
}

# shellcheck disable=SC2016 # jq programs
hook_detail() {
    # $1 event, $2 pane, $3 JSON payload. Writes detail-<pane> as
    # "epoch|event|text" for the one-line context shown next to the state.
    local event=$1 pane=$2 text prog file tmp now_s epoch ev
    file="$TA_STATE_DIR/detail-$pane"
    case $event in
    PermissionRequest)
        prog='(.tool_name // "") as $t | (.tool_input // {}) as $i
            | ([$i.command, $i.file_path, $i.url, $i.pattern, $i.description, $i.prompt]
               | map(select(. != null and . != "")) | .[0] | if . == null then "" else tostring end) as $a
            | if $a == "" then $t else "\($t): \($a)" end'
        ;;
    Notification) prog='.message // ""' ;;
    Stop) prog='(.last_assistant_message // "") | split("\n") | map(select(test("\\S"))) | .[0] // ""' ;;
    StopFailure)
        prog='((.error // .error_type // "") | tostring) as $e
            | ((.error_details // .error_message // "") | tostring) as $m
            | (if $e != "" and $m != "" then "\($e): \($m)" else "\($e)\($m)" end) as $t
            | if $t != "" then $t
              else (.last_assistant_message // "") | tostring | split("\n") | map(select(test("\\S"))) | .[0] // "" end'
        ;;
    UserPromptSubmit) prog='(.prompt // .user_prompt // "") | split("\n") | map(select(test("\\S"))) | .[0] // ""' ;;
    *) return 0 ;;
    esac
    text=$(jq -r "$prog" <<<"$3" 2>/dev/null) || return 0
    text=$(ta_sanitize "$text")
    [[ -n $text ]] || return 0
    now_s=$(now)
    # Claude fires Notification right after PermissionRequest; the latter
    # says more, so it keeps the slot for a while.
    if [[ $event == Notification && -f $file ]]; then
        IFS='|' read -r epoch ev _ <"$file" || true
        if [[ $ev == PermissionRequest && $epoch =~ ^[0-9]+$ ]] && ((now_s - epoch < 30)); then
            return 0
        fi
    fi
    # The temp name stays outside the detail-* glob the scan sweeps.
    tmp="$TA_STATE_DIR/.detail-$pane.$$"
    printf '%s|%s|%s\n' "$now_s" "$event" "$text" >"$tmp" && mv "$tmp" "$file"
}

cmd_hook() {
    # Agent lifecycle hook: tmux-agent hook <agent> <event>. Runs inside the
    # agent, so it never fails, never writes to stdout (Claude Code feeds
    # hook stdout back to the model) and never waits on the pane scan.
    local event=${2:-} pane=${TMUX_PANE:-} state prev='' report payload=''
    # Claude Code and Codex pipe a JSON payload. Events off the hot path
    # (not the per-tool ones) are parsed for a one-line detail; the rest
    # is drained unread.
    if [[ ! -t 0 ]]; then
        case $event in
        PermissionRequest | Notification | Stop | StopFailure | UserPromptSubmit)
            if command -v jq >/dev/null 2>&1; then
                payload=$(head -c 1048576 2>/dev/null) || true
            fi
            ;;
        esac
        cat >/dev/null 2>&1 || true
    fi
    [[ -n $pane ]] || return 0
    state=$(ta_hook_state "$event")
    [[ -n $state ]] || return 0
    mkdir -p "$TA_STATE_DIR"
    [[ -z $payload ]] || hook_detail "$event" "$pane" "$payload" 2>/dev/null || true
    report="$TA_STATE_DIR/report-$pane"
    if [[ $state == end ]]; then
        rm -f "$report" "$TA_STATE_DIR/detail-$pane"
    else
        [[ -f $report ]] && IFS='|' read -r prev _ <"$report"
        printf '%s|%s\n' "$state" "$(now)" >"$report"
        # Tool hooks fire constantly; only a new state needs a rescan.
        [[ $state != "$prev" ]] || return 0
    fi
    (
        refresh 1
        tmux list-clients -F '#{client_name}' | while read -r c; do
            tmux refresh-client -S -t "$c"
        done
    ) </dev/null >/dev/null 2>&1 &
    return 0
}

unplace_strip() {
    # Drop strips placed earlier, from any path or limit, out of stdin.
    sed -E 's/(#\[nolist align=absolute-centre\]| )?#\([^)]*tmux-agent[^)]*strip[^)]*\)//g'
}

cmd_place_strip() {
    # Centre the agent strip in the status bar: insert it into
    # status-format[0] just before the status-right section. Formats
    # without that section get the strip appended to status-right.
    # Re-running replaces the strip, so a moved plugin or a new limit
    # takes effect on config reload.
    local max strip fmt marker='#[nolist align=right' right
    max=$(strip_max "$@")
    strip="#('$SELF' strip --max $max)"
    fmt=$(tmux show -gv 'status-format[0]' 2>/dev/null) || return 0
    fmt=$(unplace_strip <<<"$fmt")
    if [[ $fmt == *"$marker"* ]]; then
        tmux set -g 'status-format[0]' \
            "${fmt/"$marker"/"#[nolist align=absolute-centre]$strip$marker"}"
    else
        right=$(tmux show -gv status-right 2>/dev/null | unplace_strip)
        tmux set -g status-right "$right $strip"
    fi
}

goto_remote() {
    # $1 "<key>/<pane>", $2 client name (optional). Each host gets one local
    # window, tagged @tmux-agent-remote, running a nested tmux client over
    # ssh. The first jump opens it attached to the pane's session; later
    # ones reuse it and have the far tmux-agent move that client to the pane.
    local key=${1%%/*} pane=${1#*/} wid='' w tag session
    local -a client=() target=()
    [[ -z ${2:-} ]] || client=(-c "$2")
    ta_remote_target "$key" || {
        echo "unknown remote host: $key" >&2
        return 1
    }
    while IFS='|' read -r w tag; do
        if [[ $tag == "$key" ]]; then
            wid=$w
            break
        fi
    done < <(tmux list-windows -a -F '#{window_id}|#{@tmux-agent-remote}' 2>/dev/null || true)
    if [[ -n $wid ]]; then
        ta_remote_ssh "$key" focus --pane "$pane" >/dev/null 2>&1 || true
    else
        if session=$(tmux display-message -p ${client[@]+"${client[@]}"} '#{session_name}' 2>/dev/null) &&
            [[ -n $session ]]; then
            target=(-t "$session:")
        fi
        # A pane id names its session, so attach needs no lookup first.
        wid=$(tmux new-window -d -P -F '#{window_id}' ${target[@]+"${target[@]}"} \
            -n "@$TA_REMOTE_NAME" "${TA_REMOTE_ARGV[@]}" -t "$TA_REMOTE_DEST" \
            "tmux attach-session -t $pane \\; select-window -t $pane \\; select-pane -t $pane") ||
            return 1
        [[ -n $wid ]] || return 1
        tmux set-option -w -t "$wid" @tmux-agent-remote "$key"
        (ta_remote_ssh "$key" seen "$pane" || true) </dev/null >/dev/null 2>&1 &
    fi
    tmux switch-client ${client[@]+"${client[@]}"} -t "$wid" 2>/dev/null ||
        tmux select-window -t "$wid"
}

goto_pane() {
    # $1 pane id, or "<key>/<pane>" for a remote agent; $2 client name
    # (optional; default: tmux's current client).
    local pane=$1 wid
    local -a client=()
    if [[ $pane == */* ]]; then
        goto_remote "$@"
        return
    fi
    [[ -z ${2:-} ]] || client=(-c "$2")
    # switch-client with a pane target changes session, window and pane at
    # once, so agents in other sessions (e.g. sessionizer ones) are reachable.
    # Without an attached client, fall back to selecting in place.
    if ! tmux switch-client ${client[@]+"${client[@]}"} -t "$pane" 2>/dev/null; then
        wid=$(tmux display-message -p -t "$pane" '#{window_id}')
        tmux select-window -t "$wid"
        tmux select-pane -t "$pane"
    fi
    mark_seen "$pane"
}

cmd_attach() {
    # --next: most urgent agent in any state. --urgent: only agents that
    # need you, blocked, then error, then ready. --from <pane>: the candidate after
    # that pane, wrapping, so repeated jumps cycle through them.
    local urgent=0 from=''
    while (($#)); do
        case $1 in
        --urgent)
            urgent=1
            shift
            ;;
        --from)
            from=${2:-}
            shift $(($# > 1 ? 2 : 1))
            ;;
        *) shift ;;
        esac
    done
    refresh
    local st id pane i
    local -a panes=()
    while IFS='|' read -r st _ _ _ _ id _; do
        [[ $urgent == 0 || $st == blocked || $st == error || $st == ready ]] && panes+=("$id")
    done < <(each_agent)
    if ((${#panes[@]} == 0)); then
        if ((urgent)); then
            echo "no agent needs you" >&2
        else
            echo "no agent panes" >&2
        fi
        return 1
    fi
    pane=${panes[0]}
    for i in "${!panes[@]}"; do
        if [[ ${panes[i]} == "$from" ]]; then
            pane=${panes[(i + 1) % ${#panes[@]}]}
            break
        fi
    done
    goto_pane "$pane"
}

pick_client() {
    # $1 session. "name|pid" of the most recently active client on that
    # session, else of the most recently active client anywhere.
    local name pid session any='' on=''
    while IFS='|' read -r _ name pid session; do
        [[ -n $name ]] || continue
        [[ -n $any ]] || any="$name|$pid"
        if [[ -z $on && $session == "$1" ]]; then
            on="$name|$pid"
        fi
    done < <(tmux list-clients -F '#{client_activity}|#{client_name}|#{client_pid}|#{session_name}' 2>/dev/null |
        sort -t '|' -k1,1nr || true)
    printf '%s' "${on:-$any}"
}

cmd_focus() {
    # Notification click: switch a client to the pane, then raise the
    # terminal window that client runs in (lib/raise).
    local pane='' session client
    while (($#)); do
        case $1 in
        --pane)
            pane=${2:-}
            shift $(($# > 1 ? 2 : 1))
            ;;
        *) shift ;;
        esac
    done
    [[ -n $pane ]] || return 1
    if [[ $pane == */* ]]; then
        # A remote agent: its window can be in any session.
        session=''
    else
        # Notifications outlive panes (swaync keeps them in its panel).
        session=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || return 0
        [[ -n $session ]] || return 0
    fi
    client=$(pick_client "$session")
    if [[ -z $client ]]; then
        echo "no tmux client attached" >&2
        return 1
    fi
    goto_pane "$pane" "${client%%|*}"
    "$(dirname "$SELF")/../lib/raise" "${client##*|}" </dev/null >/dev/null 2>&1 || true
}

ta_send_key_ok() {
    # $1 key name. The keys send accepts: no shell, no arbitrary tmux key.
    case $1 in
    Enter | Escape | Tab | Space | BSpace | Up | Down | Left | Right | C-c) return 0 ;;
    [ynYN0-9]) return 0 ;;
    esac
    return 1
}

cmd_send() {
    # --pane <id|key/pane>, then --key and --text in the order to type them.
    # Only agent panes take input. A remote one is forwarded to its host.
    local pane='' expect='' epoch='' cur rstate repoch ag i st=''
    local -a acts=()
    while (($#)); do
        case $1 in
        --pane)
            pane=${2:-}
            shift 2 || break
            ;;
        --expect-state)
            expect=${2:-}
            shift 2 || break
            ;;
        --expect-epoch)
            epoch=${2:-}
            shift 2 || break
            ;;
        --key)
            ta_send_key_ok "${2:-}" || {
                echo "send: key not allowed: ${2:-}" >&2
                return 2
            }
            acts+=("$1" "$2")
            shift 2
            ;;
        --text)
            [[ $# -ge 2 ]] || return 2
            acts+=("$1" "$2")
            shift 2
            ;;
        *)
            echo "send: unknown argument: $1" >&2
            return 2
            ;;
        esac
    done
    if [[ -z $pane || ${#acts[@]} -eq 0 ]]; then
        echo "usage: tmux-agent send --pane <id> (--key K | --text T)..." >&2
        return 2
    fi
    if [[ $pane == */* ]]; then
        ta_remote_ssh "${pane%%/*}" send --pane "${pane#*/}" \
            ${expect:+--expect-state "$expect"} ${epoch:+--expect-epoch "$epoch"} "${acts[@]}"
        return
    fi
    # A guarded send must not trust a scan up to 3s old: a hook report
    # may already say the prompt is gone.
    if [[ -n $expect ]]; then
        refresh 1
    else
        refresh
    fi
    [[ -f $TA_STATE_DIR/state-$pane ]] || {
        echo "send: not an agent pane: $pane" >&2
        return 1
    }
    if [[ -n $expect ]]; then
        IFS='|' read -r st ag _ <"$TA_STATE_DIR/state-$pane" || true
        # A report newer than the scan outranks the cached state.
        if [[ -f $TA_STATE_DIR/report-$pane ]]; then
            IFS='|' read -r rstate repoch <"$TA_STATE_DIR/report-$pane" || true
            [[ $repoch =~ ^[0-9]+$ ]] || repoch=0
            if report_authoritative "$rstate" "$repoch" "$(now)" "$([[ $ag != custom ]] && echo 1 || echo 0)"; then
                st=$rstate
            fi
        fi
        if [[ $st != "$expect" ]]; then
            echo "send: pane changed: now $st" >&2
            return 3
        fi
    fi
    if [[ -n $epoch ]]; then
        cur=$(ta_detail_epoch "$TA_STATE_DIR" "$pane" || true)
        if [[ $cur != "$epoch" ]]; then
            echo "send: pane changed: new request" >&2
            return 3
        fi
    fi
    for ((i = 0; i < ${#acts[@]}; i += 2)); do
        if [[ ${acts[i]} == --key ]]; then
            tmux send-keys -t "$pane" "${acts[i + 1]}"
        else
            tmux send-keys -t "$pane" -l -- "${acts[i + 1]}"
        fi
    done
}

mobile_rows() {
    # One agent per line for the phone list: state mark, agent@host and
    # directory, then the pane id after a tab, hidden by fzf.
    refresh
    local st ag host tgt age id path
    while IFS='|' read -r st ag host tgt age id path; do
        printf '%s %s%s  %s  %s\t%s\n' "$(ta_state_mark "$st")" "$ag" "${host:+@$host}" \
            "${path##*/}" "$(age_str "$age")" "$id"
    done < <(each_agent)
}

mobile_open() {
    # $1 pane id or "<key>/<pane>". Inside tmux, jump there; from a plain
    # terminal (a phone ssh session) attach to the pane's session instead.
    local pane=$1 tail
    if [[ -n ${TMUX:-} ]]; then
        goto_pane "$pane"
        return
    fi
    tail="${pane#*/}"
    if [[ $pane == */* ]]; then
        ta_remote_target "${pane%%/*}" || return 1
        "${TA_REMOTE_ARGV[@]}" -t "$TA_REMOTE_DEST" \
            "tmux attach-session -t $tail \\; select-window -t $tail \\; select-pane -t $tail" || true
    else
        tmux attach-session -t "$tail" \; select-window -t "$tail" \; select-pane -t "$tail" || true
    fi
}

mobile_menu() {
    # $1 pane id. Big rows to tap; each key sent keeps the menu open so
    # the pane's new state shows in the preview. Back (or Esc) leaves.
    local pane=$1 sel act text
    local -a rows=(
        $'⏎  Enter (approve)\tkey Enter'
        $'y  Yes\tkey y'
        $'n  No\tkey n'
        $'1\tkey 1'
        $'2\tkey 2'
        $'3\tkey 3'
        $'Esc\tkey Escape'
        $'^C  Interrupt\tkey C-c'
        $'↑  Up\tkey Up'
        $'↓  Down\tkey Down'
        $'Type a reply...\ttext'
        $'Open full session\topen'
        $'Back\tback'
    )
    while :; do
        sel=$(printf '%s\n' "${rows[@]}" | fzf --reverse --no-sort --no-scrollbar \
            --delimiter=$'\t' --with-nth=1 --header "$pane" \
            --preview "$SELF read --pane '$pane' --lines 40 --ansi" \
            --preview-window 'up,45%,wrap') || return 0
        act=${sel##*$'\t'}
        case $act in
        key\ *) "$SELF" send --pane "$pane" --key "${act#key }" || true ;;
        text)
            read -r -e -p 'reply> ' text || return 0
            [[ -z $text ]] || "$SELF" send --pane "$pane" --text "$text" --key Enter || true
            ;;
        open)
            mobile_open "$pane"
            return 0
            ;;
        *) return 0 ;;
        esac
    done
}

cmd_mobile() {
    command -v fzf >/dev/null 2>&1 || {
        echo "tmux-agent mobile needs fzf" >&2
        return 1
    }
    local sel reload
    reload="reload($SELF mobile-rows)"
    FZF_LISTEN_TICKER=''
    # Ctrl-C or a dropped ssh session must not leave the ticker behind.
    trap 'fzf_listen_stop; trap - INT TERM HUP; exit 130' INT TERM HUP
    while :; do
        if [[ -z $(mobile_rows) ]]; then
            echo "no agent panes (retrying, Ctrl-C to quit)" >&2
            sleep 3
            continue
        fi
        # Refresh the list every 2s through fzf's keyed listen port.
        fzf_listen_start "$reload"
        sel=$(mobile_rows | fzf --ansi --reverse --no-sort --no-scrollbar ${FZF_LISTEN_ARGS[@]+"${FZF_LISTEN_ARGS[@]}"} \
            --delimiter=$'\t' --with-nth=1 --header 'tap an agent' \
            --bind "ctrl-r:$reload" \
            --preview "$SELF read --pane {2} --lines 40 --ansi" \
            --preview-window 'bottom,55%,wrap') || sel=''
        fzf_listen_stop
        [[ -n $sel ]] || {
            trap - INT TERM HUP
            return 0
        }
        mobile_menu "${sel##*$'\t'}"
    done
}

cmd_remotes() {
    # One line per host: name, key, how it was found, last fetch and age,
    # agent count.
    refresh
    local k name sock st epoch n meta
    [[ -f $TA_STATE_DIR/remotes ]] || cmd_remote_refresh
    [[ -f $TA_STATE_DIR/remotes ]] || return 0
    while IFS='|' read -r k name sock _; do
        [[ -n $k ]] || continue
        st=pending epoch=$(now) n=0
        meta=$TA_STATE_DIR/remote-$k.meta
        [[ -f $meta ]] && IFS='|' read -r st epoch <"$meta"
        [[ -f $TA_STATE_DIR/remote-$k ]] && n=$(grep -c . "$TA_STATE_DIR/remote-$k" || true)
        printf '%s\t%s\t%s\t%s %s ago\t%s agents%s\n' "$name" "$k" \
            "$([[ -n $sock ]] && echo connected || echo listed)" \
            "$st" "$(age_str "$(($(now) - epoch))")" "$n" \
            "$([[ $st == noplugin ]] && echo ' (install tmux-agentic-plugin there)')"
    done <"$TA_STATE_DIR/remotes"
}

cmd_watch() {
    # What a remote host's watcher reads (lib/remote.sh). A frame is the
    # porcelain lines and a "--" line, sent when the list changes apart from
    # ages, and every 5 seconds regardless as a heartbeat. Ends with its
    # reader: the next write fails.
    local cur sig prev='' beat=0 now_s
    while :; do
        refresh
        cur=$(porcelain)
        sig=$(cut -d'|' -f1-5,7- <<<"$cur")
        now_s=$(now)
        if [[ $sig != "$prev" ]] || ((now_s - beat >= 5)); then
            [[ -z $cur ]] || printf '%s\n' "$cur"
            printf -- '--\n'
            prev=$sig beat=$now_s
        fi
        sleep 1
    done
}

cmd_remote_refresh() {
    # One fetch round now, unless one is already running.
    mkdir -p "$TA_STATE_DIR"
    if ! ta_remote_enabled; then
        ta_remote_clear
        return 0
    fi
    if command -v flock >/dev/null 2>&1; then
        local fd
        exec {fd}>"$TA_STATE_DIR/remote.lock"
        flock -n "$fd" || return 0
        # Watchers started by the round close it, or they would keep it.
        TA_REMOTE_LOCK_FD=$fd
        ta_remote_round
        return 0
    fi
    # No flock (macOS): mkdir is atomic. A lock older than two minutes was
    # left by a killed round.
    local lock=$TA_STATE_DIR/remote.lock.d
    if ! mkdir "$lock" 2>/dev/null; then
        [[ -n $(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null) ]] || return 0
        rmdir "$lock" 2>/dev/null || true
        mkdir "$lock" 2>/dev/null || return 0
    fi
    ta_remote_round || true
    rmdir "$lock" 2>/dev/null || true
}

usage() {
    # The header comment, up to the first line of code.
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$SELF"
}

main() {
    local cmd=${1:-}
    shift || true
    case $cmd in
    refresh) refresh "${1:-0}" ;;
    strip) strip "$@" ;;
    window-dot) window_dot "${1:-}" ;;
    pane-label) pane_label "${1:-}" ;;
    seen) cmd_seen "${1:-}" ;;
    status) cmd_status "$@" ;;
    pick) cmd_pick ;;
    read) cmd_read "$@" ;;
    wait) cmd_wait "$@" ;;
    report) cmd_report "$@" ;;
    hook) cmd_hook "$@" || true ;;
    place-strip) cmd_place_strip "$@" ;;
    install-hooks) "$(dirname "$SELF")/../lib/install-hooks" "$@" ;;
    attach) cmd_attach "$@" ;;
    focus) cmd_focus "$@" ;;
    remotes) cmd_remotes ;;
    send) cmd_send "$@" ;;
    pick-rows) pick_reload ;;
    pick-action) pick_action "$@" ;;
    detail) cmd_detail "$@" ;;
    diff) cmd_diff "$@" ;;
    mobile) cmd_mobile ;;
    doctor) cmd_doctor "$@" ;;
    explain) cmd_explain "$@" ;;
    mobile-rows) mobile_rows ;;
    remote-refresh) cmd_remote_refresh ;;
    watch) cmd_watch ;;
    *)
        usage
        exit 1
        ;;
    esac
}

main "$@"
